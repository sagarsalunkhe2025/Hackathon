{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/backend/src/RoleAssistant.Api/RoleAssistant.Api.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "install frontend",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "problemMatcher": []
        }
    ]
}
